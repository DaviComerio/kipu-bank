		"devdoc": {
			"author": "Student",
			"details": "Follows checks-effects-interactions pattern; uses custom errors and NatSpec; simple nonReentrant guard.",
			"events": {
				"Deposit(address,uint256,uint256)": {
					"params": {
						"amount": "amount deposited (wei)",
						"newBalance": "user's new balance after deposit",
						"who": "depositor address"
					}
				},
				"Withdrawal(address,uint256,uint256)": {
					"params": {
						"amount": "amount withdrawn (wei)",
						"newBalance": "user's new balance after withdrawal",
						"who": "withdrawer address"
					}
				}
			},
			"kind": "dev",
			"methods": {
				"constructor": {
					"params": {
						"_bankCap": "global cap for total deposits (wei)",
						"_withdrawalLimit": "per-transaction withdrawal limit (wei)"
					}
				},
				"deposit()": {
					"custom:security": "Checks-Effects-Interactions followed (no external calls on deposit).",
					"details": "external payable; enforces BANK_CAP; updates state then emits event."
				},
				"getBalance(address)": {
					"params": {
						"who": "address to query"
					},
					"returns": {
						"_0": "wei balance of `who` stored in the contract"
					}
				},
				"getMyBalance()": {
					"returns": {
						"_0": "balance of msg.sender"
					}
				},
				"withdraw(uint256)": {
					"details": "Follows CEI: effects before interaction. Uses nonReentrant modifier and safe call pattern.",
					"params": {
						"amount": "amount in wei to withdraw"
					}
				}
			},
			"title": "KipuBank — simple per-user ETH vault with global cap and per-tx withdraw limit",
			"version": 1
		},
		"userdoc": {
			"errors": {
				"DirectDepositNotAllowed()": [
					{
						"notice": "Thrown when ETH is sent directly to contract instead of calling deposit()."
					}
				],
				"ExceedsBankCap(uint256,uint256)": [
					{
						"notice": "Thrown when a deposit would exceed the bank's global cap."
					}
				],
				"ExceedsWithdrawalLimit(uint256,uint256)": [
					{
						"notice": "Thrown when withdrawal amount exceeds per-transaction limit."
					}
				],
				"InsufficientBalance(uint256,uint256)": [
